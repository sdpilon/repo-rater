{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!.output",
      "!.vinxi",
      "!dist",
      "!.vercel",
      "!.claude",
      "!.beads"
    ]
  },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 }
}
