{
  "name": "repo-rater",
  "version": "0.1.0",
  "description": "Self-hosted dashboard that scores your GitHub repos' actual progress against their stated goals using an LLM",
  "private": true,
  "license": "MIT",
  "author": "Spencer Pilon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdpilon/repo-rater.git"
  },
  "homepage": "https://github.com/sdpilon/repo-rater#readme",
  "bugs": {
    "url": "https://github.com/sdpilon/repo-rater/issues"
  },
  "keywords": ["github", "dashboard", "self-hosted", "solidstart", "llm", "postgres"],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "pipeline": "tsx src/pipeline/run.ts",
    "seed:fake": "tsx src/pipeline/seed-fake-data.ts",
    "deps:outdated": "pnpm outdated",
    "deps:update": "pnpm update -i --latest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.0-rc.6",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^3.22.0",
    "marked": "^18.0.9",
    "nitro": "^3.0.260610-beta",
    "octokit": "^5.0.5",
    "pg": "^8.22.0",
    "solid-js": "^1.9.14",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@electric-sql/pglite": "^0.5.4",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^4.1.10"
  }
}
