{
  "name": "repo-rater",
  "version": "0.1.0",
  "description": "Self-hosted dashboard that scores your GitHub repos' actual progress against their stated goals using an LLM",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm run format && pnpm test",
    "tidy": "pnpm run lint:fix && pnpm run format:fix",
    "pipeline": "tsx src/pipeline/run.ts",
    "seed:fake": "tsx src/pipeline/seed-fake-data.ts",
    "screenshot": "node scripts/screenshot-dashboard.mjs",
    "deps:outdated": "pnpm outdated",
    "deps:update": "pnpm update -i --latest"
  },
  "private": true,
  "license": "MIT",
  "author": "Spencer Pilon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdpilon/repo-rater.git"
  },
  "homepage": "https://github.com/sdpilon/repo-rater#readme",
  "bugs": {
    "url": "https://github.com/sdpilon/repo-rater/issues"
  },
  "keywords": [
    "github",
    "dashboard",
    "self-hosted",
    "solidstart",
    "llm",
    "postgres"
  ],
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.4",
    "dompurify": "^3.4.14",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.11",
    "nitro": "^3.0.260610-beta",
    "octokit": "^5.0.5",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7",
    "solid-js": "^1.9.15",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@electric-sql/pglite": "^0.5.8",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.2",
      "onFail": "download"
    }
  }
}
